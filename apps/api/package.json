{
  "name": "api",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --port 8787 --env development",
    "dev:prod": "wrangler dev --port 8787 --env production",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "build": "tsc",
    "lint": "eslint .",
    "format": "prettier --write .",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "deploy": "wrangler deploy --env production",
    "deploy:dev": "wrangler deploy --env development",
    "deploy:prod": "wrangler deploy --env production"
  },
  "dependencies": {
    "@quake-map/db": "workspace:*",
    "@hono/zod-openapi": "^0.15.0",
    "@hono/zod-validator": "^0.2.2",
    "@hono/swagger-ui": "^0.4.0",
    "drizzle-orm": "^0.32.0",
    "hono": "^4.9.6",
    "postgres": "^3.4.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "eslint": "^8.54.0",
    "eslint-config-prettier": "^9.0.0",
    "prettier": "^3.1.0",
    "typescript": "^5.3.0",
    "wrangler": "^4.4.0",
    "vitest": "^1.6.0",
    "dotenv": "^16.4.5"
  }
}